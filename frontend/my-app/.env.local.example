# Copy this file to .env.local for local development, and set the same
# key in Vercel's Project Settings -> Environment Variables for deploys.

# URL of the Django backend API (no trailing slash).
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (replace with your EC2 public DNS / domain once it has HTTPS):
# NEXT_PUBLIC_API_URL=https://ec2-x-x-x-x.compute-1.amazonaws.com
