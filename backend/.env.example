# Copy this file to backend/.env for local dev, and set the same values as
# real environment variables (e.g. in docker-compose.yml / an EC2 systemd
# unit / your secrets manager) in production. Never commit the real .env.

GEMINI_API_KEY=your-gemini-api-key

# --- Local dev defaults (safe to leave as-is) ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
COOKIE_CROSS_SITE=False
# DATABASE_URL left unset locally -> falls back to SQLite.

# --- Production values (used by docker-compose.yml on the AWS server) ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DJANGO_ALLOWED_HOSTS=ec2-x-x-x-x.compute-1.amazonaws.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# COOKIE_CROSS_SITE=True

# --- Database ---
# Managed Postgres (Neon). Get this connection string from your Neon
# project dashboard -> Connection Details. Keep "sslmode=require" - Neon
# requires TLS. Used both locally and in production; leave unset to fall
# back to local SQLite instead.
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&channel_binding=require
